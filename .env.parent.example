# Central parent on the VPS. Never copy this file's real values into a remix.
GATEWAY_ROLE=central
HOST=127.0.0.1
PORT=3000
PARENT_PUBLIC_URL=https://secretsof.delvertokens.store
API_PUBLIC_URL=https://api.delvertokens.store
GATOR_PUBLIC_URL=https://api.delvertokens.store
GATOR_ADMIN_TOKEN=
GATOR_ADMIN_BOOTSTRAP_USERNAME=admin
# scrypt-v1 password hash generated privately; used only when the account store is empty.
GATOR_ADMIN_BOOTSTRAP_PASSWORD_HASH=
GATOR_ADMIN_DATA_DIR=/app/data/admin
GATOR_ALLOW_LEGACY_ADMIN_TOKEN=false
GATOR_ALLOW_LEGACY_CLIENT_KEYS=true
GATOR_SUPABASE_URL=
GATOR_SUPABASE_SERVICE_ROLE_KEY=
GATOR_REGISTRATION_MODE=auto
# Optional legacy signed mode only: REMIX_SYNC_SECRET=
