# Any Lovable project with the server hook: server-only settings
LOVABLE_API_KEY=
# Public HTTPS URL of the central Gator; required in production.
GATOR_PUBLIC_URL=
# Alternatively set the public URL once in src/lib/central-address.ts before remixing.
GATOR_REGISTRATION_MODE=auto
# Optional legacy signed mode only: GATOR_REGISTRATION_MODE=signed and REMIX_SYNC_SECRET.

# Central Supabase credentials and admin secrets belong ONLY in gator/.env.
# See gator/.env.example. Do not configure the service-role key in a remix.
