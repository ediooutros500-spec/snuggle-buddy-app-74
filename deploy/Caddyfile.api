{
  admin off
  auto_https off
}

:8080 {
  request_body {
    max_size 2MB
  }
  handle /health {
    reverse_proxy gator:20128
  }
  handle /api/public/v1/workers/register {
    reverse_proxy gator:20128
  }
  @inference path /v1/models /v1/chat/completions /v1/messages /v1/images/generations /v1/embeddings /v1/videos/generations
  handle @inference {
    # Compatibility bridge while the unified engine is completed in Gator.
    rewrite * /api/public{uri}
    reverse_proxy parent:3000 {
      flush_interval -1
    }
  }
  handle / {
    header Content-Type application/json
    respond `{"service":"zilong-api","base_path":"/v1","authentication":"Bearer client API key"}` 200
  }
  handle {
    respond "Not found" 404
  }
}
