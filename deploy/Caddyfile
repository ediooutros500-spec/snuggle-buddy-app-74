{$PANEL_HOST} {
  reverse_proxy parent:3000 {
    flush_interval -1
  }
}

{$API_HOST} {
  request_body {
    max_size 2MB
  }
  handle /health {
    reverse_proxy gator:20128
  }
  handle /api/public/v1/workers/register {
    reverse_proxy gator:20128
  }
  handle /v1/* {
    # Temporary compatibility bridge until the unified engine lives in Gator.
    rewrite * /api/public{uri}
    reverse_proxy parent:3000 {
      flush_interval -1
    }
  }
  handle {
    respond "Not found" 404
  }
}
